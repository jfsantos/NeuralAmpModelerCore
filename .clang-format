# Use the Google C++ Style Guide as the foundation
BasedOnStyle: Google

# Language version
Standard: c++20

# Common adjustments (optional)
IndentWidth: 2
ColumnLimit: 80
AllowShortFunctionsOnASingleLine: Empty

# Sort includes alphabetically (Google standard)
SortIncludes: true

# Ensure pointers are aligned to the left: int* p (Google standard)
DerivePointerAlignment: false
PointerAlignment: Left
